+private struct NativeFormAuditProbe: View {
+    let mode: String
+    @State private var values = Array(repeating: "125.5", count: 40)
+    @State private var selected = Array(repeating: true, count: 40)
+    @Environment(\.dynamicTypeSize) private var dynamicTypeSize
+
+    var body: some View {
+        ScrollViewReader { proxy in
+            VStack(spacing: 0) {
+                if mode.hasPrefix("form") && mode != "form-no-chrome" {
+                    Text("第 2 步，共 2 步：确认促销")
+                        .font(.headline)
+                        .fixedSize(horizontal: false, vertical: true)
+                        .frame(maxWidth: .infinity, alignment: .leading)
+                        .padding(16)
+                }
+                if mode.hasPrefix("form-eager") {
+                    ScrollView {
+                        VStack(alignment: .leading, spacing: 11) {
+                            ForEach(0..<7, id: \.self) { index in
+                                nativeRows(index)
+                            }
+                        }
+                        .padding(.horizontal, 40)
+                        .padding(.vertical, 11)
+                    }
+                    .animation(nil, value: dynamicTypeSize)
+                    .accessibilityIdentifier("probe.form")
+                } else {
+                    Form {
+                        if mode.hasPrefix("leaf-") {
+                            ForEach(0..<40, id: \.self) { index in
+                                switch mode.replacingOccurrences(of: "-scrolled", with: "") {
+                                case "leaf-caption":
+                                    Text("计入金额（CNY）")
+                                        .font(.caption)
+                                        .fixedSize(horizontal: false, vertical: true)
+                                        .padding(.leading, 24)
+                                        .accessibilityIdentifier("probe.leaf.\(index)")
+                                        .id(index)
+                                case "leaf-toggle":
+                                    Toggle("选中", isOn: $selected[index])
+                                        .accessibilityIdentifier("probe.leaf.\(index)")
+                                case "leaf-field":
+                                    TextField("0.00", text: $values[index])
+                                        .textFieldStyle(.plain)
+                                        .accessibilityIdentifier("probe.leaf.\(index)")
+                                        .id(index)
+                                case "leaf-field-stack":
+                                    VStack(alignment: .leading, spacing: 7) {
+                                        TextField("0.00", text: $values[index])
+                                            .textFieldStyle(.plain)
+                                            .accessibilityIdentifier("probe.leaf.\(index)")
+                                    }
+                                    .padding(.leading, 24)
+                                case "leaf-text-stack":
+                                    VStack(alignment: .leading, spacing: 7) {
+                                        Text("125.5")
+                                            .font(.body)
+                                            .accessibilityIdentifier("probe.leaf.\(index)")
+                                    }
+                                    .padding(.leading, 24)
+                                case "leaf-pair":
+                                    Text("125.5")
+                                        .font(.body)
+                                        .accessibilityIdentifier("probe.leaf.\(index)")
+                                    Text("123").font(.caption)
+                                case "leaf-section":
+                                    Section {
+                                        Text("125.5")
+                                            .font(.body)
+                                            .accessibilityIdentifier("probe.leaf.\(index)")
+                                        Text("123").font(.caption)
+                                    }
+                                default:
+                                    Text("125.5")
+                                        .font(.body)
+                                        .accessibilityIdentifier("probe.leaf.\(index)")
+                                        .id(index)
+                                }
+                            }
+                        } else if mode == "control" {
+                            Text("Intentional clipped native text control")
+                                .font(.largeTitle)
+                                .frame(width: 180, height: 12)
+                                .clipped()
+                                .accessibilityIdentifier("probe.clipped")
+                        } else if mode == "single" {
+                            TextField("Amount", text: $values[0])
+                                .textFieldStyle(.plain)
+                                .accessibilityIdentifier("probe.amount.0")
+                        } else if mode.hasPrefix("form-flat-rows") {
+                            ForEach(0..<28, id: \.self) { row in
+                                nativeFlatRow(row)
+                            }
+                        } else {
+                            ForEach(0..<(mode == "form-one-group" ? 1 : 7), id: \.self) { index in
+                                if mode == "form-sections" {
+                                    Section { nativeRows(index) }
+                                } else {
+                                    nativeRows(index)
+                                }
+                            }
+                        }
+                    }
+                    .animation(nil, value: dynamicTypeSize)
+                    .accessibilityIdentifier("probe.form")
+                }
+                if mode.hasPrefix("form") && mode != "form-no-chrome" {
+                    VStack(spacing: 0) {
+                        Divider()
+                        if mode.hasSuffix("control") {
+                            Text("Intentional clipped native text control")
+                                .font(.largeTitle)
+                                .frame(width: 180, height: 12)
+                                .clipped()
+                                .accessibilityIdentifier("probe.clipped")
+                        }
+                        Button("返回修改交易") {}
+                            .font(.footnote.weight(.medium))
+                            .padding(.top, 8)
+                        Button {} label: {
+                            Text("确认并保存").frame(maxWidth: .infinity)
+                        }
+                        .buttonStyle(.borderedProminent)
+                        .controlSize(.large)
+                        .padding(.horizontal, 16)
+                        .padding(.vertical, 10)
+                    }
+                    .background(.bar, ignoresSafeAreaEdges: .bottom)
+                }
+            }
+            .task {
+                if mode.hasSuffix("-scrolled") {
+                    await Task.yield()
+                    proxy.scrollTo(20, anchor: .top)
+                    return
+                }
+                guard mode.hasPrefix("form") && mode != "form-top" else { return }
+                await Task.yield()
+                proxy.scrollTo("probe.input.0", anchor: .top)
+            }
+        }
+    }
+
+    @ViewBuilder
+    private func nativeRows(_ index: Int) -> some View {
+        Toggle(mode == "form-short-title" ? "选中" : "UI Activity \(index)", isOn: $selected[index])
+            .listRowSeparator(.hidden, edges: .bottom)
+        Text("CNY · 达标 1,000")
+            .font(.caption)
+            .foregroundStyle(.secondary)
+            .fixedSize(horizontal: false, vertical: true)
+            .listRowSeparator(.hidden, edges: .bottom)
+        Text("计入金额（CNY）")
+            .font(.caption)
+            .foregroundStyle(.secondary)
+            .fixedSize(horizontal: false, vertical: true)
+            .padding(.leading, 24)
+            .listRowSeparator(.hidden, edges: .bottom)
+        if mode == "form-flat-input" {
+            TextField("0.00", text: $values[index])
+                .textFieldStyle(.plain)
+                .accessibilityLabel("UI Activity \(index)计入金额（CNY）")
+                .accessibilityIdentifier("probe.amount.\(index)")
+                .padding(.leading, 24)
+                .id("probe.input.\(index)")
+            if index == 0 {
+                HStack(alignment: .firstTextBaseline, spacing: 8) {
+                    Image(systemName: "exclamationmark.triangle")
+                        .accessibilityHidden(true)
+                    Text("计入金额应为大于 0 的数字。")
+                        .fixedSize(horizontal: false, vertical: true)
+                }
+                .font(.footnote)
+                .foregroundStyle(.red)
+                .accessibilityElement(children: .combine)
+                .accessibilityLabel("错误：计入金额应为大于 0 的数字。")
+                .accessibilityIdentifier("probe.error")
+                .padding(.leading, 24)
+            }
+        } else {
+            VStack(alignment: .leading, spacing: 7) {
+                if mode == "form-text-values" {
+                    Text(values[index])
+                        .font(.body)
+                        .accessibilityIdentifier("probe.amount.\(index)")
+                } else {
+                    TextField("0.00", text: $values[index])
+                        .textFieldStyle(.plain)
+                        .accessibilityLabel("UI Activity \(index)计入金额（CNY）")
+                        .accessibilityIdentifier("probe.amount.\(index)")
+                }
+                if index == 0 && mode != "form-no-error" {
+                    HStack(alignment: .firstTextBaseline, spacing: 8) {
+                        Image(systemName: "exclamationmark.triangle")
+                            .accessibilityHidden(true)
+                        Text("计入金额应为大于 0 的数字。")
+                            .fixedSize(horizontal: false, vertical: true)
+                    }
+                    .font(.footnote)
+                    .foregroundStyle(.red)
+                    .accessibilityElement(children: .combine)
+                    .accessibilityLabel("错误：计入金额应为大于 0 的数字。")
+                    .accessibilityIdentifier("probe.error")
+                }
+            }
+            .padding(.leading, 24)
+            .id("probe.input.\(index)")
+        }
+    }
+
+    @ViewBuilder
+    private func nativeFlatRow(_ row: Int) -> some View {
+        let index = row / 4
+        switch row % 4 {
+        case 0:
+            Toggle("UI Activity \(index)", isOn: $selected[index])
+                .listRowSeparator(.hidden, edges: .bottom)
+        case 1:
+            Text("CNY · 达标 1,000")
+                .font(.caption)
+                .foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+                .listRowSeparator(.hidden, edges: .bottom)
+        case 2:
+            Text("计入金额（CNY）")
+                .font(.caption)
+                .foregroundStyle(.secondary)
+                .fixedSize(horizontal: false, vertical: true)
+                .padding(.leading, 24)
+                .listRowSeparator(.hidden, edges: .bottom)
+        default:
+            VStack(alignment: .leading, spacing: 7) {
+                TextField("0.00", text: $values[index])
+                    .textFieldStyle(.plain)
+                    .accessibilityLabel("UI Activity \(index)计入金额（CNY）")
+                    .accessibilityIdentifier("probe.amount.\(index)")
+                if index == 0 {
+                    HStack(alignment: .firstTextBaseline, spacing: 8) {
+                        Image(systemName: "exclamationmark.triangle")
+                            .accessibilityHidden(true)
+                        Text("计入金额应为大于 0 的数字。")
+                            .fixedSize(horizontal: false, vertical: true)
+                    }
+                    .font(.footnote)
+                    .foregroundStyle(.red)
+                    .accessibilityElement(children: .combine)
+                    .accessibilityLabel("错误：计入金额应为大于 0 的数字。")
+                    .accessibilityIdentifier("probe.error")
+                }
+            }
+            .padding(.leading, 24)
+            .id("probe.input.\(index)")
+        }
+    }
+
+}
diff --git a/CardPilotUITests/CoreFlowsUITests.swift b/CardPilotUITests/CoreFlowsUITests.swift
index 96f69da..304eb70 100644
--- a/CardPilotUITests/CoreFlowsUITests.swift
+++ b/CardPilotUITests/CoreFlowsUITests.swift
@@ -33,6 +33,83 @@ final class CoreFlowsUITests: XCTestCase {
         app = nil
     }
 
+    func testNativeMixedFlatRowsProbe() throws {
+        try runNativeFormAuditProbe("form-flat-rows")
+    }
+
+    func testNativeMixedFlatRowsControlProbe() throws {
+        try runNativeFormAuditProbe("form-flat-rows-control")
+    }
+
+    func testNativeMixedEagerRowsProbe() throws {
+        try runNativeFormAuditProbe("form-eager")
+    }
+
+    func testNativeMixedEagerRowsControlProbe() throws {
+        try runNativeFormAuditProbe("form-eager-control")
+    }
+
+    private func runNativeFormAuditProbe(_ mode: String) throws {
+        app.launchArguments += ["-UIPreferredContentSizeCategoryName", UIContentSizeCategory.accessibilityExtraExtraExtraLarge.rawValue]
+        app.launchEnvironment["CARDPILOT_UI_SCENARIO"] = "empty"
+        app.launchEnvironment["CARDPILOT_AUDIT_PROBE"] = mode
+        app.launch()
+        let open = app.buttons["probe.open"]
+        XCTAssertTrue(open.waitForExistence(timeout: 10))
+        open.tap()
+        XCTAssertTrue(app.navigationBars["原生表单"].waitForExistence(timeout: 10))
+        let form = app.descendants(matching: .any).matching(identifier: "probe.form").firstMatch
+        XCTAssertTrue(form.waitForExistence(timeout: 10))
+        if mode.hasPrefix("leaf-") {
+            let index = mode.hasSuffix("-scrolled") ? 20 : 0
+            let first = app.descendants(matching: .any).matching(identifier: "probe.leaf.\(index)").firstMatch
+            XCTAssertTrue(first.waitForExistence(timeout: 10))
+            XCTAssertTrue(form.frame.contains(first.frame))
+        } else if mode == "form-top" {
+            XCTAssertTrue(app.switches.firstMatch.waitForExistence(timeout: 10))
+        } else if mode == "control" {
+            XCTAssertTrue(app.staticTexts["probe.clipped"].waitForExistence(timeout: 10))
+        } else {
+            let first = mode == "form-text-values" ? app.staticTexts["probe.amount.0"] : app.textFields["probe.amount.0"]
+            XCTAssertTrue(first.waitForExistence(timeout: 10))
+            XCTAssertEqual(mode == "form-text-values" ? first.label : first.value as? String, "125.5")
+            if mode.hasPrefix("form") && mode != "form-no-error" {
+                let error = app.staticTexts["probe.error"]
+                let visible = NSPredicate { _, _ in
+                    first.exists && error.exists && first.frame.minY >= form.frame.minY
+                        && error.frame.maxY <= form.frame.maxY
+                }
+                expectation(for: visible, evaluatedWith: nil)
+                waitForExpectations(timeout: 10)
+            }
+        }
+        captureScreenshot("native-probe-\(mode)-before")
+        let before = XCTAttachment(string: app.debugDescription)
+        before.name = "native-probe-\(mode)-before-AX"
+        before.lifetime = .keepAlways
+        add(before)
+        continueAfterFailure = true
+        var count = 0
+        try app.performAccessibilityAudit(for: .textClipped) { issue in
+            count += 1
+            let details = "mode=\(mode)\n\(issue.compactDescription)\n\(issue.detailedDescription)\n\(issue.element?.debugDescription ?? "No associated element")"
+            let raw = XCTAttachment(string: details)
+            raw.name = "native-probe-\(mode)-issue"
+            raw.lifetime = .keepAlways
+            self.add(raw)
+            self.captureScreenshot("native-probe-\(mode)-callback")
+            let hierarchy = XCTAttachment(string: self.app.debugDescription)
+            hierarchy.name = "native-probe-\(mode)-callback-AX"
+            hierarchy.lifetime = .keepAlways
+            self.add(hierarchy)
+            return false
+        }
+        if mode.hasSuffix("control") {
+            XCTAssertGreaterThan(count, 0, "Positive control must detect intentional clipping")
+        }
+        captureScreenshot("native-probe-\(mode)-after")
+    }
+
     func testAccountEditorNumericKeyboardPreservesSavedLimit() {
         verifyAccountEditorNumericKeyboard(largestText: false)
     }
