+// Diagnostic-only native controls, without CardPilot domain or editor code.
+private struct NativeFormAuditProbeRoot: View {
+    let mode: String
+    @State private var presented = false
+
+    var body: some View {
+        Button("Open native probe") { presented = true }
+            .accessibilityIdentifier("probe.open")
+            .sheet(isPresented: $presented) {
+                NavigationStack {
+                    NativeFormAuditProbe(mode: mode)
+                        .navigationTitle("原生表单")
+                        .navigationBarTitleDisplayMode(.inline)
+                }
+            }
+    }
+}
